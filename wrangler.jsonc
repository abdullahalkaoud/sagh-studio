// Cloudflare Worker config. Workers Builds runs:  node build.js  →  npx wrangler deploy
{
  "name": "sagh",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  // GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET are set in the dashboard (as Secrets); don't let deploys drop them
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // only the login endpoints go through worker.js; everything else is served straight from dist/
    "run_worker_first": ["/api/*"]
  },
  "observability": { "enabled": true }
}
